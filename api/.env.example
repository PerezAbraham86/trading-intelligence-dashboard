# Webhook secret for validating TradingView alerts (optional)
WEBHOOK_SECRET=

# Authenticated Client Portal Gateway reachable from the backend (server-side only)
IBKR_BASE_URL=https://localhost:5000/v1/api
# Obtain exact contract IDs from IBKR. Do not guess futures IDs or expiry.
IBKR_CONID_MAP={}
# Optional shortcut for MES1! (use the current expiry's IBKR contract ID)
IBKR_MES_CONID=
IBKR_TIMEOUT_SECONDS=15
IBKR_HISTORY_PERIOD=1d
IBKR_HISTORY_CACHE_SECONDS=60
IBKR_VERIFY_TLS=true
# IBKR_CA_BUNDLE=/path/to/trusted-gateway-ca.pem
