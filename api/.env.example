# Webhook secret for validating TradingView alerts (optional)
WEBHOOK_SECRET=

# Authenticated Client Portal Gateway reachable from the backend (server-side only)
IBKR_BASE_URL=https://localhost:5000/v1/api
# Obtain exact contract IDs from IBKR. Do not guess futures IDs or expiry.
IBKR_CONID_MAP={}
# Optional shortcut for MES1! (use the current expiry's IBKR contract ID)
IBKR_MES_CONID=
IBKR_TIMEOUT_SECONDS=15
IBKR_HISTORY_PERIOD=1d
IBKR_HISTORY_CACHE_SECONDS=60
IBKR_VERIFY_TLS=true
# IBKR_CA_BUNDLE=/path/to/trusted-gateway-ca.pem

# Exact frontend origins, comma-separated; never use *.
CORS_ALLOWED_ORIGINS=https://trading-intelligence-dashboard.onrender.com,https://trading-intelligence-dashboard.vercel.app,http://localhost:3000
# Existing backend memory location; local storage is ephemeral on a free Render service.
# NEURAL_BRAIN_DB_PATH=.data/neural_brain_memory.sqlite3
NEURAL_BRAIN_ONLINE_READY_EXAMPLES=25
NEURAL_BRAIN_ONLINE_LEARNING_RATE=0.035
NEURAL_BRAIN_ONLINE_L2=0.00025
