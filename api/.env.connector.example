# Connector-side only. Copy to ignored .env.connector; never commit its secret.
IBKR_TWS_ENABLED=false
IBKR_TWS_HOST=127.0.0.1
# gateway or tws; live or paper only determines the default if PORT is absent.
IBKR_TWS_APPLICATION=gateway
IBKR_TWS_ENVIRONMENT=live
IBKR_TWS_PORT=4001
IBKR_TWS_CLIENT_ID=11
IBKR_TWS_READONLY=true
IBKR_TWS_TIMEOUT_SECONDS=15
IBKR_TWS_RECONNECT_MIN_SECONDS=30
IBKR_TWS_RECONNECT_MAX_SECONDS=300
IBKR_TWS_HEARTBEAT_SECONDS=20
IBKR_SYMBOL=SPY
IBKR_BAR_SIZE=1 min
IBKR_HISTORY_DURATION=1 D
IBKR_USE_RTH=false
IBKR_RELAY_ENABLED=false
IBKR_RELAY_SECRET=
IBKR_RELAY_CONNECTOR_ID=marketbos-spy
IBKR_RELAY_BACKEND_URL=https://trading-intelligence-dashboard-1.onrender.com
